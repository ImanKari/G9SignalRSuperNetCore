{
  "name": "@g9/signalr-supernetcore-client",
  "version": "2.9.0",
  "description": "TypeScript twin of the G9SignalRSuperNetCore .NET client: resilient connection, JWT authorize route, resumable file upload/download, connection quality monitor and error codes.",
  "license": "MIT",
  "author": "Iman Kari (G9TM)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "PARITY.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "signalr",
    "g9",
    "supernetcore",
    "resumable-upload",
    "reconnect"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "pack:vendor": "npm run build && node scripts/pack-vendor.mjs"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^10.0.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
