{
  "name": "@g9tm/signalr-supernetcore-lynx",
  "version": "2.10.1",
  "description": "Lynx support for the G9SignalRSuperNetCore TypeScript client: a binary WebSocket native module (Android OkHttp, iOS URLSessionWebSocketTask, Lynxtron/Node), runtime shims and a ready-made G9Client factory for the Lynx background thread.",
  "license": "MIT",
  "author": "Iman Kari (G9TM)",
  "homepage": "https://github.com/ImanKari/G9SignalRSuperNetCore/tree/main/js/packages/lynx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImanKari/G9SignalRSuperNetCore.git",
    "directory": "js/packages/lynx"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lynxtron": {
      "types": "./dist/lynxtron/index.d.ts",
      "import": "./dist/lynxtron/index.js",
      "default": "./dist/lynxtron/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android/build.gradle.kts",
    "android/consumer-rules.pro",
    "android/src/main",
    "ios/g9tm-signalr-lynx.podspec",
    "ios/src",
    "generated",
    "types",
    "lynx.lib.json",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "signalr",
    "lynx",
    "websocket",
    "g9",
    "native-module"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../client/scripts/clean.mjs",
    "build": "node ../client/scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && node scripts/android-bridge-types.mjs",
    "test:lynxsim": "vitest run --config vitest.lynxsim.config.ts",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "test:android-jvm": "node scripts/run-gradle.mjs -p jvm test",
    "check:android-module": "node scripts/run-gradle.mjs -p android-check build",
    "test:ios-core": "node scripts/test-ios-core.mjs",
    "codegen": "lynx-autolink-codegen && node scripts/android-bridge-types.mjs --fix",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@g9tm/signalr-supernetcore-client": "2.10.1",
    "@microsoft/signalr": "^10.0.0"
  },
  "devDependencies": {
    "@g9tm/signalr-supernetcore-client": "2.10.1",
    "@lynx-js/autolink-codegen": "0.6.0",
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "@msgpack/msgpack": "^2.8.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "ws": "^8.18.3"
  }
}
