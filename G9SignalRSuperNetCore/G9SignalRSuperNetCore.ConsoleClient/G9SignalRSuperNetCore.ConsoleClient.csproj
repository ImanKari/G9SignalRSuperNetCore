<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<RootNamespace>G9SignalRSuperNetCore.ConsoleClient</RootNamespace>

		<!-- Surface the generator-emitted source files on disk so they're visible in the IDE
		     under Dependencies > Analyzers and easy to inspect during development. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

		<!-- Consolonia: "Avalonia for the terminal" — gives us a real UI tree (windows, lists, buttons,
		     keyboard nav) inside a normal terminal. https://github.com/jinek/Consolonia -->
		<PackageReference Include="Consolonia" Version="11.3.7-beta.1831" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\G9SignalRSuperNetCore.Client\G9SignalRSuperNetCore.Client.csproj" />
		<ProjectReference Include="..\G9SignalRSuperNetCore.Sample.Shared\G9SignalRSuperNetCore.Sample.Shared.csproj" />
		<ProjectReference Include="..\G9SignalRSuperNetCore.SourceGenerator\G9SignalRSuperNetCore.SourceGenerator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
