<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G9SignalRSuperNetCore.ConsoleClient.MainWindow"
        RequestedThemeVariant="Dark"
        Title="G9SignalRSuperNetCore — Console Test Harness">
    <DockPanel LastChildFill="True">

        <!-- Status bar (top) -->
        <Border DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock Name="StatusText" Text=" G9SignalRSuperNetCore  |  Disconnected " DockPanel.Dock="Left" />
                <Button Name="ExitButton" Content="[ Exit ]" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <!-- Tabs (main body) -->
        <TabControl Name="MainTabs">

            <!-- TAB 1: Connection -->
            <TabItem Header="Connection">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <TextBlock Text="Server URL:  " VerticalAlignment="Center" />
                        <TextBox Name="ServerUrlBox" Text="https://localhost:7159" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Display name: " VerticalAlignment="Center" />
                        <TextBox Name="UserNameBox" Text="Iman" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ConnectButton" Content="[ Connect ]" />
                        <Button Name="DisconnectButton" Content="[ Disconnect ]" IsEnabled="False" />
                        <Button Name="ClearConnectionButton" Content="[ Clear log ]" />
                    </StackPanel>
                    <TextBlock Text="Connection log:" />
                    <ListBox Name="ConnectionLog" />
                </StackPanel>
            </TabItem>

            <!-- TAB 2: Chat -->
            <TabItem Header="Chat">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Bottom">
                        <Button Name="SendButton" Content="[ Send ]" DockPanel.Dock="Right" IsEnabled="False" />
                        <TextBox Name="MessageBox" Text="G9SignalRSuperNetCore" />
                    </DockPanel>
                    <Button Name="ClearChatButton" Content="[ Clear log ]" DockPanel.Dock="Top" />
                    <ListBox Name="ChatLog" />
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Recent messages -->
            <TabItem Header="Recent">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                        <Button Name="GetRecentButton" Content="[ Fetch recent ]" IsEnabled="False" />
                        <Button Name="ClearRecentButton" Content="[ Clear log ]" />
                    </StackPanel>
                    <ListBox Name="RecentLog" />
                </DockPanel>
            </TabItem>

            <!-- TAB 4: File transfer -->
            <TabItem Header="File transfer">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="── Upload ──────────────────────────────────────────────" />
                    <DockPanel>
                        <TextBlock Text="File path: " VerticalAlignment="Center" />
                        <Button Name="BrowseButton" Content="[ Browse... ]" DockPanel.Dock="Right" />
                        <TextBox Name="UploadPathBox" Text="file_upload_test.zip" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Chunk size (KB): " VerticalAlignment="Center" />
                        <TextBox Name="ChunkSizeBox" Text="64" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="UploadButton" Content="[ Upload ]" IsEnabled="False" />
                        <Button Name="UploadBreakButton" Content="[ Upload then break ]" IsEnabled="False" />
                        <Button Name="UploadResumeButton" Content="[ Resume upload ]" IsEnabled="False" />
                        <Button Name="CancelUploadButton" Content="[ Cancel ]" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Name="UploadStatus" Text="No upload in flight." />
                    <ProgressBar Name="UploadBar" Minimum="0" Maximum="100" Value="0" />

                    <TextBlock Text="── Download ────────────────────────────────────────────" />
                    <DockPanel>
                        <TextBlock Text="Server file:  " VerticalAlignment="Center" />
                        <TextBox Name="DownloadServerFileBox" Text="file_upload_test.zip" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Local target: " VerticalAlignment="Center" />
                        <TextBox Name="DownloadLocalPathBox" Text="" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="DownloadButton" Content="[ Download ]" IsEnabled="False" />
                        <Button Name="DownloadBreakButton" Content="[ Download then break ]" IsEnabled="False" />
                        <Button Name="DownloadResumeButton" Content="[ Resume download ]" IsEnabled="False" />
                        <Button Name="CancelDownloadButton" Content="[ Cancel ]" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Name="DownloadStatus" Text="No download in flight." />
                    <ProgressBar Name="DownloadBar" Minimum="0" Maximum="100" Value="0" />

                    <Button Name="ClearUploadButton" Content="[ Clear log ]" />
                    <TextBlock Text="Transfer log:" />
                    <ListBox Name="UploadLog" />
                </StackPanel>
            </TabItem>

            <!-- TAB 5: Rate-limit test -->
            <TabItem Header="Rate limit">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Sends 20 SendMessage calls in a tight loop. The hub method is" />
                    <TextBlock Text="decorated with [G9AttrRateLimit(perSecond: 5, burst: 10)]." />
                    <StackPanel Orientation="Horizontal">
                        <Button Name="RateLimitButton" Content="[ Run rate-limit burst ]" IsEnabled="False" />
                        <Button Name="ClearRateLimitButton" Content="[ Clear log ]" />
                    </StackPanel>
                    <TextBlock Text="Outcome log (G9_RATE_LIMITED expected after burst):" />
                    <ListBox Name="RateLimitLog" />
                </StackPanel>
            </TabItem>

            <!-- TAB 6: Rooms (Bundle 3) -->
            <TabItem Header="Rooms">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <TextBlock Text="Room: " VerticalAlignment="Center" />
                        <TextBox Name="RoomNameBox" Text="lobby" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="JoinRoomButton" Content="[ Join ]" IsEnabled="False" />
                        <Button Name="LeaveRoomButton" Content="[ Leave ]" IsEnabled="False" />
                        <Button Name="ListMembersButton" Content="[ List members ]" IsEnabled="False" />
                        <Button Name="ListOnlineButton" Content="[ Online users ]" IsEnabled="False" />
                    </StackPanel>
                    <DockPanel>
                        <Button Name="SendToRoomButton" Content="[ Send to room ]" DockPanel.Dock="Right" IsEnabled="False" />
                        <TextBox Name="RoomMessageBox" Text="hello room" />
                    </DockPanel>
                    <Button Name="ClearRoomsButton" Content="[ Clear log ]" />
                    <TextBlock Text="Rooms / presence log:" />
                    <ListBox Name="RoomsLog" />
                </StackPanel>
            </TabItem>

            <!-- TAB 7: Streaming (Bundle 4) -->
            <TabItem Header="Streaming">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <TextBlock Text="Tick count: " VerticalAlignment="Center" />
                        <TextBox Name="TickCountBox" Text="20" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Interval ms: " VerticalAlignment="Center" />
                        <TextBox Name="TickIntervalBox" Text="100" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="StartStreamButton" Content="[ Start ticker ]" IsEnabled="False" />
                        <Button Name="StopStreamButton" Content="[ Stop ]" IsEnabled="False" />
                        <Button Name="BulkPushButton" Content="[ Push 100 → server ]" IsEnabled="False" />
                        <Button Name="ClearStreamingButton" Content="[ Clear log ]" />
                    </StackPanel>
                    <TextBlock Text="Streaming log:" />
                    <ListBox Name="StreamingLog" />
                </StackPanel>
            </TabItem>

            <!-- TAB 8: Encrypted (Bundle 5) -->
            <TabItem Header="Encrypted">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="ECDH P-256 + HKDF-SHA-256 + ChaCha20-Poly1305 round-trip echo." />
                    <DockPanel>
                        <TextBlock Text="Plaintext: " VerticalAlignment="Center" />
                        <TextBox Name="EncPlaintextBox" Text="The quick brown fox jumps over the lazy dog." />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="HandshakeButton" Content="[ Handshake ]" IsEnabled="False" />
                        <Button Name="EncryptedEchoButton" Content="[ Encrypted echo ]" IsEnabled="False" />
                        <Button Name="ClearEncryptedButton" Content="[ Clear log ]" />
                    </StackPanel>
                    <TextBlock Text="Encrypted log:" />
                    <ListBox Name="EncryptedLog" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
